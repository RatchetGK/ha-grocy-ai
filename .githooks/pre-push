#!/bin/sh
# Scan every commit that is about to be pushed (incl. tags).
zero=0000000000000000000000000000000000000000
status=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # deleting a ref
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"                            # new branch/tag: full history
  else
    range="$remote_sha..$local_sha"
  fi
  python scripts/check_private_data.py --range "$range" || status=1
done
exit $status
